# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# App URL (for Stripe redirects)
VITE_APP_URL=http://localhost:5173

# Stripe Configuration (Optional - managed in Admin UI)
# These are for server-side integration if needed
# The admin UI stores these encrypted in the database

# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Webhook Configuration
# STRIPE_WEBHOOK_URL=https://your-domain.com/api/webhooks/stripe

# Stripe Redirect URLs
# STRIPE_SUCCESS_URL=https://your-domain.com/payment-success
# STRIPE_CANCEL_URL=https://your-domain.com/payment-cancel

# Notes:
# - All Stripe keys are managed through the Admin UI (Admin → Stripe Integration)
# - Keys are encrypted before storage in the database
# - Server-side environment variables are only needed for backend API integration
# - Frontend loads Stripe keys from the database (decrypted client-side)

# Backend API Base URL (für lokale PHP API)
# Lokale Entwicklung mit XAMPP: http://localhost/stimmumeter/api
# Produktion: https://your-domain.com/api
VITE_API_BASE_URL=http://localhost/stimmumeter/api
VITE_API_BASE_URL=http://localhost/stimmumeter/api
