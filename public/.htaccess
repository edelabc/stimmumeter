# ==========================================
# Stimmumeter - Produktions .htaccess
# ==========================================
# Diese Datei wird beim Build in dist/ kopiert
# ==========================================

# HTTPS-Umleitung - Alle HTTP-Requests zu HTTPS umleiten
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# SSL erzwingen - Sicherheits-Header
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Permissions-Policy: Geolocation erlauben (für Standort-Features)
  Header always set Permissions-Policy "geolocation=(self), microphone=(), camera=()"
  
  # Content Security Policy (CSP) - Dynamisch für lokal und Produktion
  # Erlaubt localhost für Entwicklung und aktuelle Domain für Produktion
  <IfModule mod_headers.c>
    # Für lokale Entwicklung (localhost)
    <If "%{HTTP_HOST} =~ /^localhost/">
      Header always set Content-Security-Policy "default-src 'self' http://localhost:* http://127.0.0.1:*; script-src 'self' 'unsafe-inline' 'unsafe-eval' http://localhost:* http://127.0.0.1:* https://maps.googleapis.com https://maps.gstatic.com; style-src 'self' 'unsafe-inline' http://localhost:* http://127.0.0.1:* https://fonts.googleapis.com; font-src 'self' http://localhost:* http://127.0.0.1:* https://fonts.gstatic.com; img-src 'self' data: http: https: blob:; connect-src 'self' http://localhost:* http://127.0.0.1:* https://maps.googleapis.com https://*.supabase.co; frame-src 'self' http://localhost:* http://127.0.0.1:* https://maps.google.com;"
    </If>
    # Für Produktion (alle anderen Domains) - erlaubt aktuelle Domain dynamisch
    <Else>
      Header always set Content-Security-Policy "default-src 'self' https://%{HTTP_HOST}; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://%{HTTP_HOST} https://maps.googleapis.com https://maps.gstatic.com; style-src 'self' 'unsafe-inline' https://%{HTTP_HOST} https://fonts.googleapis.com; font-src 'self' https://%{HTTP_HOST} https://fonts.gstatic.com; img-src 'self' data: https: blob:; connect-src 'self' https://%{HTTP_HOST} https://maps.googleapis.com https://*.supabase.co; frame-src 'self' https://%{HTTP_HOST} https://maps.google.com;"
    </Else>
  </IfModule>
</IfModule>

# React/Vite SPA Routing
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Handle Angular/React Router - alle Requests zu index.html umleiten
  # Ausnahme: API-Endpunkte, Assets, etc.
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteCond %{REQUEST_URI} !^/assets/
  RewriteCond %{REQUEST_URI} !^/favicon\.ico$
  RewriteCond %{REQUEST_URI} !^/robots\.txt$
  RewriteCond %{REQUEST_URI} !^/sitemap\.xml$
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Gzip Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  
  # Bilder - 1 Jahr
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  
  # CSS und JavaScript - 1 Monat
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  
  # Fonts - 1 Jahr
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  
  # PDF und andere Dokumente - 1 Monat
  ExpiresByType application/pdf "access plus 1 month"
  
  # HTML - keine Caching (immer aktuell)
  ExpiresByType text/html "access plus 0 seconds"
  
  # JSON - keine Caching
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# Cache-Control Header (zusätzlich zu Expires)
<IfModule mod_headers.c>
  # Statische Assets - lange Caching-Zeit
  <FilesMatch "\.(jpg|jpeg|png|gif|svg|webp|ico|woff|woff2|ttf|eot)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>
  
  # CSS und JavaScript - mittlere Caching-Zeit
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "max-age=2592000, public"
  </FilesMatch>
  
  # HTML - kein Caching
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# Verzeichnis-Listing deaktivieren
Options -Indexes

# Sensible Dateien schützen
<FilesMatch "^(\.env|\.git|config\.local\.php|config\.production\.php|composer\.(json|lock)|package\.json|package-lock\.json|\.htaccess)$">
  Order allow,deny
  Deny from all
</FilesMatch>

# PHP-Dateien im dist/ Ordner nicht ausführen (nur statische Assets)
<FilesMatch "\.php$">
  Order allow,deny
  Deny from all
</FilesMatch>

# MIME-Types
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType application/json .json
  AddType font/woff .woff
  AddType font/woff2 .woff2
</IfModule>
